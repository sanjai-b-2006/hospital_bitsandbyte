# OneRecord — Example environment template
# Copy to `.env` and fill in real values. Never commit real secrets.

# Cloud PostgreSQL connection string (leave empty to use embedded PGlite locally)
DATABASE_URL=

# Server port (defaults to 5001)
PORT=5001

# OpenRouter API key for the AI Clinical Assistant (MedAssist AI)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the OpenRouter model
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Frontend API base URL (Vite reads VITE_ prefixed vars)
VITE_API_URL=http://localhost:5001/api